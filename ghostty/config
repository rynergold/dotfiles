# === GHOSTTY CONFIGURATION ===

# Font & Ligatures (JetBrains Mono Nerd Font)
font-family = "JetBrainsMono Nerd Font"
font-size = 17
adjust-cell-height = 15%
font-feature = ["calt", "liga", "dlig"]

# Color Theme (TokyoNight Moon - Soft pastel low-contrast)
theme = TokyoNight Moon

# Window Appearance (100% Clean & Borderless - Flush Status Bars & No Gaps)
window-padding-x = 14
window-padding-y = 0
window-padding-balance = false
window-padding-color = extend-always
window-decoration = false
macos-titlebar-style = hidden

# Global Hotkey (Toggles visibility while PRESERVING Rectangle positions)
# Shortcut: Option + `
keybind = global:opt+grave_accent=toggle_visibility
window-save-state = never
working-directory = home

# Window Mode (Allow Rectangle snapping)
fullscreen = false

# Neovim & UX Settings
clipboard-read = allow
clipboard-write = allow
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true
window-inherit-working-directory = true
unfocused-split-opacity = 0.85

# === LIVE VIDEO WALLPAPER ===
# A see-through window lets the desktop video (antigravity/desktop-video) show through.
# Pick the video with `agy-wallpaper`. background-opacity is the dark tint over the video:
# 0 = none, 1 = opaque (video hidden). The tint colour is the theme background (#222436).
# Cell backgrounds (tmux status, selections, colored blocks) stay opaque, so text stays readable.
background-opacity = 0.30
